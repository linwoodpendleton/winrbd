---
--- a/src/config/config.c
+++ b/src/config/config.c
@@ -147,6 +147,9 @@
 #ifdef SANBOOT_PROTO_RBD
 REQUIRE_OBJECT ( rbd_uri );
 #endif
+#if defined ( SANBOOT_PROTO_RBD ) && defined ( PLATFORM_pcbios )
+REQUIRE_OBJECT ( rbd_bios );
+#endif

 /*
  * Drag in all requested resolvers
--- a/src/include/ipxe/errfile.h
+++ b/src/include/ipxe/errfile.h
@@ -335,6 +335,7 @@
 #define ERRFILE_rbd_acpi		( ERRFILE_NET | 0x00740000 )
 #define ERRFILE_rbd_efi			( ERRFILE_NET | 0x00750000 )
 #define ERRFILE_rbd_errors		( ERRFILE_NET | 0x00760000 )
+#define ERRFILE_rbd_bios		( ERRFILE_NET | 0x00770000 )

 #define ERRFILE_image		      ( ERRFILE_IMAGE | 0x00000000 )
 #define ERRFILE_elf		      ( ERRFILE_IMAGE | 0x00010000 )
--- a/src/arch/x86/include/int13.h
+++ b/src/arch/x86/include/int13.h
@@ -71,6 +71,12 @@
 /** Block size for non-extended INT 13 calls */
 #define INT13_BLKSIZE 512

+/** Maximum size of boot firmware table(s): one area of data16 shared by every SAN device */
+#define XBFTAB_SIZE 2048
+
+/** Alignment of boot firmware table entries */
+#define XBFTAB_ALIGN 16
+
 /** @defgroup int13fddtype INT 13 floppy disk drive types
  * @{
  */
--- a/src/arch/x86/interface/pcbios/int13.c
+++ b/src/arch/x86/interface/pcbios/int13.c
@@ -1549,11 +1549,7 @@
 	return -ECANCELED; /* -EIMPOSSIBLE */
 }

-/** Maximum size of boot firmware table(s) */
-#define XBFTAB_SIZE 2048
-
-/** Alignment of boot firmware table entries */
-#define XBFTAB_ALIGN 16
+/* XBFTAB_SIZE and XBFTAB_ALIGN are in <int13.h> (winrbd patch 0004) */

 /** The boot firmware table(s) generated by iPXE */
 static uint8_t __bss16_array ( xbftab, [XBFTAB_SIZE] )
