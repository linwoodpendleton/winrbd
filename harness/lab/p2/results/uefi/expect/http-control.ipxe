#!ipxe
# winrbd Phase 2 run script for row U1, generated by gen-script.sh.
# It holds the cephx key unless it was made with --redact: keep it private (mode 600, directory 700), never commit it.
echo WRRUN-BEGIN row=U1
set labmac 52:54:00:77:12:9f
iseq ${net0/mac} ${labmac} || goto not0
set wr-if net0
goto have-if
:not0
iseq ${net1/mac} ${labmac} || goto not1
set wr-if net1
goto have-if
:not1
iseq ${net2/mac} ${labmac} || goto not2
set wr-if net2
goto have-if
:not2
iseq ${net3/mac} ${labmac} || goto not3
set wr-if net3
goto have-if
:not3
iseq ${net4/mac} ${labmac} || goto not4
set wr-if net4
goto have-if
:not4
iseq ${net5/mac} ${labmac} || goto not5
set wr-if net5
goto have-if
:not5
iseq ${net6/mac} ${labmac} || goto not6
set wr-if net6
goto have-if
:not6
iseq ${net7/mac} ${labmac} || goto not7
set wr-if net7
goto have-if
:not7
echo WRRUN-NO-LAB-NIC
goto fail
:have-if
set ${wr-if}/ip 10.77.0.31
set ${wr-if}/netmask 255.255.255.0
ifopen ${wr-if} || goto fail-net
iflinkwait -t 10000 ${wr-if} || goto fail-net
echo WRRUN-NET-OK
echo WRRUN-SAN-START sanboot
sanboot http://10.77.0.10:8088/linux.raw || goto san-fail
echo WRRUN-BOOT-RETURNED
goto fail
echo WRRUN-LEAVE exit
echo WRRUN-END
exit
:san-fail
echo WRRUN-SAN-FAILED 0x${errno:hexraw}
goto fail
:fail-net
echo WRRUN-NET-FAILED 0x${errno:hexraw}
:fail
echo WRRUN-FAIL
echo WRRUN-END
poweroff
:finished
